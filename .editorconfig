root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,cpp,cxx}]
charset = utf-8-bom

[*.{json,yml,yaml}]
indent_size = 2

[.clang-{format,tidy}]
indent_size = 2

[Source/AreaUpdateLegacy/**]
indent_style = unset
indent_size = unset
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[ThirdParty/**]
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
